<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ThermalRegisterBackgroundStyle" TargetType="UserControl">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush ImageSource="../Images/MainBackground.png" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TicketPageBackgroundStyle" TargetType="UserControl">
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush ImageSource="../Images/BackgroundApi.png" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThermalRegisterBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="BorderBrush" Value="{StaticResource WhiteBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="PopupBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Background" Value="{DynamicResource White}" />
    </Style>

    <Style x:Key="PinPadBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="BorderBrush" Value="{DynamicResource White}" />
        <Setter Property="BorderThickness" Value="4" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Opacity="0.2" Color="#FFFFFF" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KeyBoardStyle" TargetType="Border">
        <Setter Property="Width" Value="1022" />
        <Setter Property="Height" Value="318" />
        <Setter Property="BorderBrush" Value="{DynamicResource White}" />
        <Setter Property="BorderThickness" Value="4" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Opacity="0.2" Color="#FFFFFF" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BorderSelectedTicketStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{StaticResource LightGrayColorBrush}"/>
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush
                    Color="#959595"
                    Opacity="0.2"/>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>