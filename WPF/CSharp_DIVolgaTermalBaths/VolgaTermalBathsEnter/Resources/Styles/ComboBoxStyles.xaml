<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/">
    <Style TargetType="ComboBox" x:Key="CitiesComboBoxStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid Background="Transparent"
                          Width="656">
                        <Border x:Name="Border"
                                Width="656" Height="96"
                                Background="{StaticResource E6FAF8}"
                                CornerRadius="24"
                                Padding="24 34"
                                BorderThickness="1"
                                BorderBrush="{StaticResource MainColorBrush}"
                                Opacity="0.4" />
                        <TextBlock Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                                   Foreground="{Binding City, Converter={StaticResource CityToColorConverter}}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Margin="24 0 0 0"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   VerticalAlignment="Center"
                                   Opacity="0.4"
                                   Validation.ErrorTemplate="{StaticResource TextBlockErrorTemplate}"/>
                        <ToggleButton x:Name="ToggleButton"
                                      Grid.ZIndex="1"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding DataContext.IsCitySelected, RelativeSource={RelativeSource TemplatedParent},
                                            Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Width="656" Height="96" Background="Transparent">
                                        <svgc:SvgViewbox x:Name="SvgImage"
                                                         Source="/Resources/Images/arrow.svg"
                                                         Width="31" Height="15"
                                                         HorizontalAlignment="Right"
                                                         Margin="0 0 40 0">
                                            <svgc:SvgViewbox.Style>
                                                <Style TargetType="svgc:SvgViewbox">
                                                    <Setter Property="RenderTransformOrigin"
                                                            Value="0.5,0.5" />
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0" />
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding IsChecked, ElementName=ToggleButton}"
                                                            Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                                                                            To="180"
                                                                            Duration="0:0:0.2"
                                                                            FillBehavior="HoldEnd" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                                                                            To="0"
                                                                            Duration="0:0:0.2"
                                                                            FillBehavior="HoldEnd" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </svgc:SvgViewbox.Style>
                                        </svgc:SvgViewbox>
                                    </Grid>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Button Command="{Binding DataContext.ClearCityCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                Visibility="{Binding DataContext.IsCitySelected, RelativeSource={RelativeSource TemplatedParent},
                                            Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <svgc:SvgViewbox Source="/Resources/Images/Clear.svg"
                                                     Width="40" Height="40"
                                                     HorizontalAlignment="Right"
                                                     Margin="0 0 24 0"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               PlacementTarget="{Binding}"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade"
                               VerticalOffset="12">
                            <Grid x:Name="DropDown"
                                  SnapsToDevicePixels="True"
                                  MaxHeight="582">
                                <Border Background="White"
                                        CornerRadius="24"
                                        Width="656"
                                        Height="582"
                                        SnapsToDevicePixels="True"
                                        Padding="12 24"
                                        BorderThickness="3"
                                        BorderBrush="{StaticResource MainColorBrush}" />
                                <ScrollViewer Margin="12 24"
                                              SnapsToDevicePixels="True"
                                              Padding="0 0 0 -8">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar"
                                               BasedOn="{StaticResource CitiesScrollBarStyle}" />
                                    </ScrollViewer.Resources>
                                    <UniformGrid IsItemsHost="True"
                                                 KeyboardNavigation.DirectionalNavigation="Contained"
                                                 Columns="1" />
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Border" Property="BorderThickness" Value="3" />
                            <Setter TargetName="Border" Property="BorderBrush"
                                    Value="{DynamicResource AccentColorBrush}" />
                        </Trigger>

                        <Trigger Property="IsDropDownOpen" Value="False">
                            <Setter TargetName="Border" Property="BorderThickness" Value="1" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem" x:Key="CitiesComboBoxItemStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Border"
                            Width="616" Height="52"
                            CornerRadius="12"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            Margin="0 0 0 8">
                        <TextBlock x:Name="TextBlock"
                                    Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontFamily="{StaticResource DinPro}"
                                   Text="{Binding}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="12 0 0 0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource MainColorBrush}"/>
                            <Setter TargetName="TextBlock" Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>