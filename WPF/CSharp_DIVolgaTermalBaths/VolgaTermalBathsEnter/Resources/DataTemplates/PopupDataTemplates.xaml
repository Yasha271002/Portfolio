<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:popups="clr-namespace:VolgaTermalBathsEnter.ViewModels.Popups"
                    xmlns:popups1="clr-namespace:VolgaTermalBathsEnter.Views.Popups"
                    xmlns:cardOnTerminal="clr-namespace:VolgaTermalBathsEnter.ViewModels.Popups.CardOnTerminal">
    <DataTemplate DataType="{x:Type popups:PasswordPopupViewModel}">
        <popups1:PasswordPopupView DataContext="{Binding}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type popups:ErrorPopupViewModel}">
        <popups1:ErrorPopup DataContext="{Binding}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type popups:ThanksGoTurnstilePopupViewModel}">
        <popups1:ThanksGoTurnstilePopup DataContext="{Binding}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type cardOnTerminal:PaymentPopupViewModel}">
        <popups1:CardOnTerminalPopup DataContext="{Binding }"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type popups:ScanAdultBraceletViewModel}">
        <popups1:ScanAdultBracelet DataContext="{Binding }"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type popups:AddDataViewModel}">
        <popups1:AddDataPage DataContext="{Binding}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type popups:BraceletApplyViewModel}">
        <popups1:BraceletApply DataContext="{Binding}" />
    </DataTemplate>
</ResourceDictionary>