<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="ThermalRegisterButton" TargetType="Button">
        <Border
        Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="1"
        CornerRadius="24"
        Name="Border"
        Width="{TemplateBinding Width}"
        Height="{TemplateBinding Height}">
            <TextBlock
                Foreground="{TemplateBinding Foreground}"
                Style="{DynamicResource ButtonTextStyle}"
                Text="{TemplateBinding Content}"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource E2E2E2}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="InvisibleButtonPopupExit" TargetType="Button">
        <Border
        Width="{TemplateBinding Width}"
        Height="{TemplateBinding Height}"
        Background="Transparent">

        </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="PinPadButton" TargetType="Button">
        <Border
        Width="96"
        Height="96"
        CornerRadius="16"
        Background="{DynamicResource White}"
        BorderThickness="1">
            <TextBlock
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Style="{DynamicResource TextBlockFontWeightNormal}"
            FontSize="32"
            Foreground="{DynamicResource 303030}"
            Text="{TemplateBinding Content}"/>
        </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="PinPadBackButton">
        <Border
        Width="208"
        Height="96"
        Background="{DynamicResource White}"
        CornerRadius="16"
        BorderThickness="1">
            <ContentPresenter
            ContentTemplate="{DynamicResource BackPinPadLogo}"
            Width="48"
            Height="24"/>
        </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="ButtonTimeTemplate" TargetType="RadioButton">
        <Border
        Width="105"
        Height="50"
        Background="{DynamicResource White}"
        CornerRadius="8"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="2"
        Margin="4 0 4 0">
            <TextBlock
            Text="{TemplateBinding Content}"
            Style="{DynamicResource TextBlockFontWeightNormal}"
            FontSize="18"
            Foreground="{DynamicResource LightGrayColorBrush}"
            VerticalAlignment="Center"/>
        </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="ButtonCountTemplate" TargetType="Button">
        <Border
        Width="57.33"
        Height="49"
        Background="{DynamicResource White}"
        CornerRadius="8"
        BorderBrush="{DynamicResource 484848}"
        BorderThickness="2">
            <TextBlock
            Text="{TemplateBinding Content}"
            Style="{DynamicResource TextBlockFontWeightNormal}"
            FontSize="18"
            Foreground="{DynamicResource 484848}"
            VerticalAlignment="Center"/>
        </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="ButtonDeleteTemplate" TargetType="Button">
        <Border
        Background="{DynamicResource White}"
        CornerRadius="24"
        BorderBrush="{DynamicResource 484848}"
        BorderThickness="2">
            <TextBlock
            Text="{TemplateBinding Content}"
            Style="{DynamicResource TextBlockFontWeightNormal}"
            FontSize="18"
            Foreground="{DynamicResource 484848}"
            VerticalAlignment="Center"/>
        </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="AddTicketButton" TargetType="Button">
        <Border
        Width="178"
        Height="50"
        Background="{DynamicResource MainColorBrush}"
        CornerRadius="8"
        BorderThickness="1">
            <TextBlock
            Text="{TemplateBinding Content}"
            Style="{DynamicResource TextBlockFontWeightNormal}"
            FontSize="18"
            Foreground="{DynamicResource White}"
            VerticalAlignment="Center"/>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="RadioButtonSelectedTime" TargetType="RadioButton">
        <Border
        Background="{TemplateBinding Background}"
        Height="50"
        CornerRadius="8"
        Margin="2">
            <TextBlock
            Foreground="{DynamicResource White}"
            FontSize="18"
            Style="{DynamicResource TextBlockFontWeightNormal}"
            VerticalAlignment="Center"
            Text="{Binding Name}" />
        </Border>
    </ControlTemplate>
</ResourceDictionary>