<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="UserRegisterTextBox" TargetType="TextBox">
        <Border
            BorderThickness="1"
            BorderBrush="{StaticResource MainColorBrush}"
            CornerRadius="24"
            Background="{DynamicResource E6FAF8}"
            Padding="0">
            <Grid>
                <Grid Margin="{TemplateBinding Padding}">
                    <TextBlock
                        Foreground="{DynamicResource MainColorBrush}"
                        Text="{TemplateBinding Tag}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        Margin="23 0 0 0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                                        Value="Collapsed">
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Text.Length,RelativeSource={RelativeSource FindAncestor,AncestorType=TextBox} }"
                                        Value="0">
                                        <Setter Property="Visibility" Value="Visible"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ScrollViewer
                    x:Name="PART_ContentHost"
                    Width="610">
                </ScrollViewer>
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="ErrorTemplate">
        <StackPanel Orientation="Vertical">
            <Border BorderBrush="{DynamicResource ErrorColor}"
                    CornerRadius="24"
                    BorderThickness="2">
                <AdornedElementPlaceholder
                    x:Name="AdornedElementPlaceholder" />
            </Border>
            <TextBlock Foreground="{DynamicResource ErrorColor}" FontSize="20" FontWeight="Normal"
                       VerticalAlignment="Bottom"
                       Text="{Binding AdornedElement.(Validation.Errors)/ErrorContent,ElementName=AdornedElementPlaceholder}" />
        </StackPanel>
    </ControlTemplate>

    <ControlTemplate x:Key="TextBlockErrorTemplate">
        <Border BorderBrush="Transparent"
                BorderThickness="0">
            <AdornedElementPlaceholder/>
        </Border>
    </ControlTemplate>
</ResourceDictionary>