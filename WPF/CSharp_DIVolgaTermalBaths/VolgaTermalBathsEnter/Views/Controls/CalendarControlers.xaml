<UserControl x:Class="VolgaTermalBathsEnter.Views.Controls.CalendarControlers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Calendar x:Name="Calendar"
              Style="{StaticResource CalendarStyle}"
              BorderThickness="0"
              DisplayDateChanged="Calendar_OnDisplayDateChanged"
              DisplayModeChanged="Calendar_DisplayModeChanged"
              SelectedDate="{Binding SelectedDate, RelativeSource={RelativeSource AncestorType=UserControl}}">
    </Calendar>
</UserControl>