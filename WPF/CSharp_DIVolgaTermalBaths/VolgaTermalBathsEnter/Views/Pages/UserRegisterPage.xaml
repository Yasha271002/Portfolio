<UserControl
    x:Class="VolgaTermalBathsEnter.Views.Pages.UserRegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:components="clr-namespace:MainComponents.Components;assembly=MainComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:VolgaTermalBathsEnter.ViewModels.Pages"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    d:DataContext="{d:DesignInstance pages:UserRegisterViewModel}"
    d:DesignHeight="1920"
    d:DesignWidth="1080"
    Style="{StaticResource ThermalRegisterBackgroundStyle}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction
                Command="{Binding LoadedCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <StackPanel>
        <Border
            Width="1022"
            Height="1482"
            Margin="29,56,29,0"
            Style="{StaticResource ThermalRegisterBorderStyle}">
            <StackPanel>
                <ContentPresenter
                    Width="292"
                    Height="176"
                    Margin="340,44,0,0"
                    HorizontalAlignment="Left"
                    ContentTemplate="{StaticResource ThermalLogo}" />
                <TextBlock
                    Width="694"
                    Margin="0,16,0,32"
                    FontSize="54"
                    Style="{DynamicResource WelcomeTextBlock}"
                    Text="Впервые у нас? Зарегистрируйтесь" />
                <TextBlock
                    Width="655"
                    Margin="0,0,0,48"
                    Style="{DynamicResource TextBlockFontWeightNormal}"
                    Text="Заполните предложенные поля для регистрации" />

                <TextBox
                    Style="{StaticResource TextBoxStyle}"
                    Tag="ФИО"
                    Text="{Binding Fio, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                    Validation.ErrorTemplate="{StaticResource ErrorTemplate}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="GotFocus">
                            <b:InvokeCommandAction Command="{Binding GotFioFocusCommand}" />
                        </b:EventTrigger>
                        <b:EventTrigger EventName="LostFocus">
                            <b:InvokeCommandAction Command="{Binding LostShiftFocusCommand}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </TextBox>
                <xctk:MaskedTextBox
                    Style="{StaticResource TextBoxStyle}"
                    Tag="Дата рождения"
                    Mask="00-00-0000"
                    Text="{Binding Birthday, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                    Validation.ErrorTemplate="{StaticResource ErrorTemplate}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="GotFocus">
                            <b:InvokeCommandAction Command="{Binding GotBirthdayFocusCommand}" />
                        </b:EventTrigger>
                        <b:EventTrigger EventName="LostFocus">
                            <b:InvokeCommandAction Command="{Binding LostShiftFocusCommand}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </xctk:MaskedTextBox>

                <Popup Placement="Center"
                       StaysOpen="True"
                       AllowsTransparency="True"
                       VerticalOffset="100"
                       HorizontalOffset="100"
                       IsOpen="{Binding IsBirthdayPopupOpen}">
                    <Border Background="White"
                            CornerRadius="16"
                            Padding="8"
                            BorderThickness="2"
                            BorderBrush="#17B8A8"
                            SnapsToDevicePixels="True">
                        <Viewbox Width="400" Height="380">
                            <Calendar BorderThickness="0" SelectedDate="{Binding BirthdayFromCalendar, Mode=TwoWay}" />
                        </Viewbox>
                    </Border>
                </Popup>

                <Grid HorizontalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Cities}"
                          SelectedItem="{Binding City}"
                          Foreground="{DynamicResource MainColorBrush}"
                          Style="{StaticResource CitiesComboBoxStyle}"
                          ItemContainerStyle="{StaticResource CitiesComboBoxItemStyle}"
                          FontFamily="{StaticResource DinPro}"
                          Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                          FontSize="28">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="GotFocus">
                                <b:InvokeCommandAction Command="{Binding GotCityFocusCommand}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </ComboBox>
                </Grid>

                <TextBox
                    Style="{StaticResource TextBoxStyle}"
                    Tag="Почта"
                    Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                    Validation.ErrorTemplate="{StaticResource ErrorTemplate}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="GotFocus">
                            <b:InvokeCommandAction Command="{Binding GotEmailFocusCommand}" />
                        </b:EventTrigger>
                        <b:EventTrigger EventName="LostFocus">
                            <b:InvokeCommandAction Command="{Binding LostShiftFocusCommand}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </TextBox>

                <Grid Width="638" Margin="0,48,0,64">
                    <CheckBox
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                        IsEnabled="True"
                        Style="{DynamicResource CheckBoxStyle}" />
                    <TextBlock
                        Margin="28,0,0,0"
                        VerticalAlignment="Center"
                        Style="{DynamicResource TextBlockFontWeightNormal}"
                        Text="Хочу участвовать в программе лояльности" />
                </Grid>
                <TextBlock
                    Width="448"
                    Style="{DynamicResource TextBlockFontSize20}"
                    Text="Нажимая на кнопку, вы даете согласие на обработку персональных данных" />

                <components:RoundedButton
                    Width="448"
                    Height="96"
                    Margin="0,24"
                    Content="Зарегистрироваться"
                    Command="{Binding RegisterCommand}"
                    Style="{StaticResource GreenAndGrayButtonStyle}">
                </components:RoundedButton>
                <components:RoundedButton
                    Margin="0,12,0,64"
                    Command="{Binding WelcomePageNavigateCommand}"
                    Content="Назад"
                    Style="{StaticResource TransparentButtonStyle}" />

            </StackPanel>
        </Border>
        <Border Margin="0,10,0,60" Style="{StaticResource KeyBoardStyle}">
            <components:Keyboard
                Width="926"
                Height="260"
                AdditionalButtonStyle="{StaticResource BaseKeyboardButtonStyle}"
                ButtonBaseMargin="4.5"
                MainButtonStyle="{StaticResource BaseKeyboardButtonStyle}"
                EmailButtonStyle="{StaticResource ButtonEmailStyle}"
                ShiftPressed="{Binding ShiftPressed, Mode=TwoWay}"
                IsDigit="{Binding IsDigit, Mode=TwoWay}"
                IsEmailPrinting="{Binding IsEmailPrinting, Mode=TwoWay}"
                CurrentLanguage="{Binding Language, Mode=TwoWay}" />
        </Border>
    </StackPanel>
</UserControl>