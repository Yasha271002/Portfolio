<UserControl
    x:Class="VolgaTermalBathsEnter.Views.Popups.ScanAdultBracelet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:MainComponents.Components;assembly=MainComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VolgaTermalBathsEnter.Views.Popups"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:popupContainers="clr-namespace:MainComponents.Popups.PopupContainers;assembly=MainComponents"
    xmlns:popups="clr-namespace:VolgaTermalBathsEnter.ViewModels.Popups"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    d:DataContext="{d:DesignInstance popups:ScanAdultBraceletViewModel}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction
                Command="{Binding LoadedCommand}" />
        </b:EventTrigger>
        <b:EventTrigger EventName="Unloaded">
            <b:InvokeCommandAction
                Command="{Binding UnloadedCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <popupContainers:OpacityPopupContainer>
        <Border
            Width="1022"
            Height="887"
            Style="{StaticResource PopupBorderStyle}">
            <StackPanel>
                <TextBlock
                    Width="768"
                    Margin="0,120,0,0"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Отсканируйте взрослый браслет"
                    TextWrapping="Wrap" />

                <ContentPresenter
                    ContentTemplate="{DynamicResource ScanLogo}"
                    Width="160"
                    Height="159"
                    Margin="104" />

                <components:RoundedButton
                    Style="{StaticResource TransparentButtonStyle}"
                    Command="{Binding CloseContainerCommand}"
                    CommandParameter="False"
                    Content="Назад" />
            </StackPanel>
        </Border>
    </popupContainers:OpacityPopupContainer>
</UserControl>