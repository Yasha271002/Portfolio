<UserControl x:Class="VolgaTermalBathsEnter.Views.Popups.CardOnTerminalPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cardOnTerminal="clr-namespace:VolgaTermalBathsEnter.ViewModels.Popups.CardOnTerminal"
             xmlns:popupContainers="clr-namespace:MainComponents.Popups.PopupContainers;assembly=MainComponents"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:Width="1022"
             d:Height="1015"
             d:DataContext="{d:DesignInstance cardOnTerminal:PaymentPopupViewModel}">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction
                Command="{Binding LoadedCommand}" />
        </b:EventTrigger>
        <b:EventTrigger EventName="Unloaded">
            <b:InvokeCommandAction
                Command="{Binding UnloadedCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <popupContainers:OpacityPopupContainer>
        <Border Style="{StaticResource PopupBorderStyle}"
                Width="1022"
                Height="1015">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Поднесите карту к терминалу"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Width="650"
                           Margin="0 120 0 0" />

                <TextBlock Margin="0 76 0 76"
                           HorizontalAlignment="Center"
                           Style="{StaticResource LabelTextBlockStyle}">
                    <Run Text="Сумма к оплате:  " Foreground="{StaticResource 171717}" />
                    <Run Foreground="{StaticResource MainColorBrush}" FontWeight="Normal" Text="{Binding TotalPriceModel.TotalPrice, StringFormat=C, ConverterCulture=BE-ru}" />
                </TextBlock>

                <ContentPresenter
                    ContentTemplate="{StaticResource CardLogo}"
                    Width="210"
                    Height="146"
                    Margin="0 0 0 76" />

                <!--<Button Content="Назад"
                        Template="{StaticResource ThermalRegisterButton}"
                        Style="{StaticResource ButtonPopupStyle}"
                        Command="{Binding CloseContainerCommand}"
                        CommandParameter="False"/>-->
            </StackPanel>
        </Border>
    </popupContainers:OpacityPopupContainer>
</UserControl>
