<UserControl
    x:Class="VolgaTermalBathsEnter.Views.Popups.BraceletApply"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:components="clr-namespace:MainComponents.Components;assembly=MainComponents"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VolgaTermalBathsEnter.Views.Popups"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:popupContainers="clr-namespace:MainComponents.Popups.PopupContainers;assembly=MainComponents"
    xmlns:popups="clr-namespace:VolgaTermalBathsEnter.ViewModels.Popups"
    d:DataContext="{d:DesignInstance popups:BraceletApplyViewModel}"
    mc:Ignorable="d">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <popupContainers:OpacityPopupContainer>
        <Border
            Width="1022"
            Height="1187"
            Style="{StaticResource PopupBorderStyle}">
            <StackPanel>
                <ContentPresenter
                    Width="259"
                    Margin="0 140 0 32"
                    ContentTemplate="{DynamicResource SummerSwimmingLogo}" />
                <TextBlock
                    Width="768"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Браслет отсканирован"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{DynamicResource TextBlockFontWeightNormal}"
                    Text="Хотите ещё приобрести билеты?"
                    Margin="0 32 0 76"/>
                <components:RoundedButton
                    Height="96"
                    Width="448"
                    Command="{Binding GoToEndPageCommand}"
                    Content="Закончить оформление"
                    Style="{StaticResource GreenButtonStyle}" />
                <components:RoundedButton
                    Margin="24"
                    Command="{Binding TicketOnOtherTimeCommand}"
                    Content="Активировать еще билет"
                    Style="{StaticResource TransparentButtonStyle}" />
                <components:RoundedButton
                    Command="{Binding TicketOnOtherTimeCommand}"
                    Content="Билет на другое время"
                    Style="{StaticResource TransparentButtonStyle}" />
            </StackPanel>
        </Border>
    </popupContainers:OpacityPopupContainer>
</UserControl>
