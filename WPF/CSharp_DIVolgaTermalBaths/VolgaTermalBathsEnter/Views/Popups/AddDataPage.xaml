<UserControl x:Class="VolgaTermalBathsEnter.Views.Popups.AddDataPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:pages="clr-namespace:VolgaTermalBathsEnter.ViewModels.Pages"
             xmlns:components="clr-namespace:MainComponents.Components;assembly=MainComponents"
             xmlns:popups="clr-namespace:VolgaTermalBathsEnter.ViewModels.Popups"
             xmlns:popupContainers="clr-namespace:MainComponents.Popups.PopupContainers;assembly=MainComponents"
             d:DataContext="{d:DesignInstance popups:AddDataViewModel}"
             mc:Ignorable="d" 
             Style="{StaticResource ThermalRegisterBackgroundStyle}"
             d:DesignHeight="1920" d:DesignWidth="1080">
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction
                Command="{Binding LoadedCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <popupContainers:ScaleContainer>
        <StackPanel>
            <Border
            Width="1022"
            Height="1202"
            Margin="29 180 29 0"
            Style="{StaticResource ThermalRegisterBorderStyle}">
                <StackPanel>
                    <ContentPresenter
                    Width="292"
                    Height="176"
                    Margin="340,44,0,0"
                    HorizontalAlignment="Left"
                    ContentTemplate="{StaticResource ThermalLogo}" />
                    <TextBlock
                    Width="694"
                    Margin="0,16,0,32"
                    FontSize="54"
                    Style="{DynamicResource WelcomeTextBlock}"
                    Text="Введите ваши данные" />
                    <TextBlock
                    Width="655"
                    Margin="0,0,0,48"
                    Style="{DynamicResource TextBlockFontWeightNormal}"
                    Text="Заполните предложенные поля для регистрации" />


                    <TextBox
                    Style="{StaticResource TextBoxStyle}"
                    Tag="Фамилия"
                    Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                    Validation.ErrorTemplate="{StaticResource ErrorTemplate}" >
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="GotFocus">
                                <b:InvokeCommandAction Command="{Binding GotLastNameFocusCommand}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </TextBox>

                    <TextBox
                    Style="{StaticResource TextBoxStyle}"
                    Tag="Имя"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                    Validation.ErrorTemplate="{StaticResource ErrorTemplate}" >
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="GotFocus">
                                <b:InvokeCommandAction Command="{Binding GotNameFocusCommand}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </TextBox>

                    <TextBox
                    Style="{StaticResource TextBoxStyle}"
                    Tag="Отчество"
                    Text="{Binding Surname, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                    Validation.ErrorTemplate="{StaticResource ErrorTemplate}" >
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="GotFocus">
                                <b:InvokeCommandAction Command="{Binding GotSurnameFocusCommand}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </TextBox>
                    <TextBlock
                    Margin="0 48 0 0"
                    Width="448"
                    Style="{DynamicResource TextBlockFontSize20}"
                    Text="Нажимая на кнопку, вы даете согласие на обработку персональных данных" />

                    <components:RoundedButton
                    Width="448"
                    Height="96"
                    Margin="0,12"
                    Content="Подтвердить"
                    Command="{Binding UpdateSelectedTicketPageCommand}"
                    Style="{StaticResource GreenAndGrayButtonStyle}" >
                    </components:RoundedButton>
                    <components:RoundedButton
                    Margin="0,12,0,64"
                    Command="{Binding GoBackCommand}"
                    CommandParameter="false"
                    Content="Назад"
                    Style="{StaticResource TransparentButtonStyle}" />

                </StackPanel>
            </Border>
            <Border Margin="0 150 0 60" Style="{StaticResource KeyBoardStyle}">
                <components:Keyboard
                Width="926"
                Height="260"
                AdditionalButtonStyle="{StaticResource BaseKeyboardButtonStyle}"
                ButtonBaseMargin="4.5"
                MainButtonStyle="{StaticResource BaseKeyboardButtonStyle}"
                ShiftPressed="{Binding ShiftPressed, Mode=TwoWay}"/>
            </Border>
        </StackPanel>
    </popupContainers:ScaleContainer>
</UserControl>
