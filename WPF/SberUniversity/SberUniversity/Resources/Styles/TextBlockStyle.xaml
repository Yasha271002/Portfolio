<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="SBSansDisplay">pack://application:,,,/Resources/Font/#SB Sans Display</FontFamily>
    <FontFamily x:Key="SBSansDisplaySemi">pack://application:,,,/Resources/Font/#SB Sans Display Semibold</FontFamily>
    <Style TargetType="TextBlock" x:Key="DefaultTextBoxStyle">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontFamily" Value="{StaticResource SBSansDisplay}"/>
        <Setter Property="Foreground" Value="{DynamicResource MainTextColorBrush}" />
    </Style>

    <Style TargetType="TextBlock" x:Key="TitleTextBoxStyle" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="FontSize" Value="72" />
    </Style>
</ResourceDictionary>