<Application x:Class="SberUniversity.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SberUniversity"
             StartupUri="..\Views\Window\MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/BorderStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/ButtonStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/ScrollBarStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/TextBlockStyle.xaml" />
                <ResourceDictionary Source="Resources/Styles/PageStyle.xaml" />
                <ResourceDictionary Source="Resources/Styles/SliderStyle.xaml" />

                <ResourceDictionary Source="Resources/CommonBrushes.xaml" />
                <ResourceDictionary Source="Resources/CommonConverters.xaml" />

                <ResourceDictionary Source="Resources/Icons.xaml" />

                <ResourceDictionary Source="Resources/Templates/ButtonTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
