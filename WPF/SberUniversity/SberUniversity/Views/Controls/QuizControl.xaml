<UserControl x:Class="SberUniversity.Views.Controls.QuizControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SberUniversity.Views.Controls"
             xmlns:views="clr-namespace:SberUniversity.ViewModel.Views"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:helpers="clr-namespace:SberUniversity.Helpers"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance views:QuizPageViewModel, IsDesignTimeCreatable=False}">
    <Border CornerRadius="36">
        <Grid>
            <Border Background="White"
                    Opacity="0.2" CornerRadius="36" Width="960" 
                    Focusable="False"/>
            <StackPanel Margin="40">
                <ItemsControl ItemsSource="{Binding Quizzes.Question}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0 36 0 36" Width="880px">
                                <TextBlock Text="{Binding Question}"
                                           Style="{StaticResource DefaultTextBoxStyle}"
                                           FontWeight="Bold"
                                           Focusable="False"
                                           Margin="0 0 0 24" />
                                <Slider Minimum="0" Maximum="900"
                                        Width="880px"
                                        Focusable="False"
                                        Value="{Binding QuestionCount, Mode=TwoWay}"
                                        IsSnapToTickEnabled="True" TickFrequency="1">
                                    <Slider.Style>
                                        <Style TargetType="Slider">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Border x:Name="TrackBackground" Grid.Row="1" Background="Transparent">
                                                            </Border>
                                                            <Track Grid.Row="1" x:Name="PART_Track">
                                                                <Track.DecreaseRepeatButton>
                                                                    <RepeatButton Style="{StaticResource SliderRepeatButton1}"/>
                                                                </Track.DecreaseRepeatButton>
                                                               
                                                                <Track.IncreaseRepeatButton>
                                                                    <RepeatButton Style="{StaticResource SliderRepeatButton2}"/>
                                                                </Track.IncreaseRepeatButton>
                                                                <Track.Thumb>
                                                                    <Thumb Style="{StaticResource QuizSliderThumb}">
                                                                        <b:Interaction.Triggers>
                                                                            <b:EventTrigger EventName="DragStarted">
                                                                                <b:InvokeCommandAction Command="{Binding DataContext.DragStartedCommand,RelativeSource={RelativeSource FindAncestor,AncestorType=UserControl}}"/>
                                                                            </b:EventTrigger>
                                                                            <b:EventTrigger EventName="DragCompleted">
                                                                                <b:InvokeCommandAction Command="{Binding DataContext.DragCompletedCommand,RelativeSource={RelativeSource FindAncestor,AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding}"/>
                                                                            </b:EventTrigger>
                                                                        </b:Interaction.Triggers>
                                                                    </Thumb>
                                                                </Track.Thumb>
                                                            </Track>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Path=DataContext.ThumbDragging,RelativeSource={RelativeSource FindAncestor,AncestorType=UserControl}}"  Value="False" />
                                                        <Condition Value="True">
                                                            <Condition.Binding>
                                                                <MultiBinding
                                                                    Converter="{StaticResource ValueInRangeConverter}">
                                                                        <Binding Path="QuestionCount" />
                                                                        <Binding>
                                                                            <Binding.Source>
                                                                                <system:Int32>0</system:Int32>
                                                                            </Binding.Source>
                                                                        </Binding>
                                                                        <Binding>
                                                                            <Binding.Source>
                                                                                <system:Int32>225</system:Int32>
                                                                            </Binding.Source>
                                                                        </Binding>
                                                                </MultiBinding>
                                                            </Condition.Binding>
                                                        </Condition>
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        
                                                        <BeginStoryboard Name="To0">
                                                            <Storyboard TargetProperty="Value">
                                                                <DoubleAnimation To="0"
                                                                    Duration="0:0:.3">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <PowerEase Power="2"
                                                                            EasingMode="EaseInOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="To0"/>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Path=DataContext.ThumbDragging,RelativeSource={RelativeSource FindAncestor,AncestorType=UserControl}}"  Value="False" />
                                                        <Condition Value="True">
                                                            <Condition.Binding>
                                                                <MultiBinding Converter="{StaticResource ValueInRangeConverter}">
                                                                    <Binding Path="QuestionCount" />
                                                                    <Binding>
                                                                            <Binding.Source>
                                                                                <system:Int32>225</system:Int32>
                                                                            </Binding.Source>
                                                                        </Binding>
                                                                    <Binding>
                                                                        <Binding.Source>
                                                                            <system:Int32>675</system:Int32>
                                                                        </Binding.Source>
                                                                    </Binding>
                                                                </MultiBinding>
                                                            </Condition.Binding>
                                                        </Condition>
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard Name="To450">
                                                            <Storyboard TargetProperty="Value">
                                                                <DoubleAnimation To="450"
                                                                    Duration="0:0:.3">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <PowerEase Power="2"
                                                                            EasingMode="EaseInOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="To450"/>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Path=DataContext.ThumbDragging,RelativeSource={RelativeSource FindAncestor,AncestorType=UserControl}}"  Value="False" />
                                                        <Condition Value="True">
                                                            <Condition.Binding>
                                                                <MultiBinding Converter="{StaticResource ValueInRangeConverter}">
                                                                    <Binding Path="QuestionCount" />
                                                                    <Binding>
                                                                            <Binding.Source>
                                                                                <system:Int32>675</system:Int32>
                                                                            </Binding.Source>
                                                                        </Binding>
                                                                    <Binding>
                                                                        <Binding.Source>
                                                                            <system:Int32>900</system:Int32>
                                                                        </Binding.Source>
                                                                    </Binding>
                                                                </MultiBinding>
                                                            </Condition.Binding>
                                                        </Condition>
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard Name="To900">
                                                            <Storyboard TargetProperty="Value">
                                                                <DoubleAnimation To="900"
                                                                    Duration="0:0:.3">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <PowerEase Power="2"
                                                                            EasingMode="EaseInOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="To900"/>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Slider.Style>
                                </Slider>
                                <UniformGrid Columns="3" Margin="0 10 0 0">
                                    <TextBlock Text="{Binding Answers.FirstQuestion}"
                                               Style="{StaticResource DefaultTextBoxStyle}"
                                               FontSize="20"
                                               TextWrapping="Wrap"
                                               Width="220"
                                               HorizontalAlignment="Left"
                                               TextAlignment="Left" />
                                    <TextBlock Text="{Binding Answers.SecondQuestion}"
                                               Style="{StaticResource DefaultTextBoxStyle}"
                                               FontSize="20"
                                               TextWrapping="Wrap"
                                               Width="280"
                                               TextAlignment="Center" />
                                    <TextBlock Text="{Binding Answers.ThreeQuestion}"
                                               Style="{StaticResource DefaultTextBoxStyle}"
                                               FontSize="20"
                                               TextWrapping="Wrap"
                                               Width="260"
                                               HorizontalAlignment="Right"
                                               TextAlignment="Right" />
                                </UniformGrid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>