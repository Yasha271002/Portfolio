<UserControl x:Class="SberUniversity.Views.Popups.PersonalData"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SberUniversity.Views.Popups"
             xmlns:helpers="clr-namespace:SberUniversity.Helpers"
             xmlns:popups1="clr-namespace:SberUniversity.ViewModel.Popups"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <popups1:UserAgreementViewModel />
    </UserControl.DataContext>

    <Border CornerRadius="36" Padding="60 70" Background="White">
        <StackPanel Width="840">
            <TextBlock Style="{StaticResource TitleTextBoxStyle}"
                       Text="Согласие на обработку персональных данных"
                       Width="540" HorizontalAlignment="Left" TextAlignment="Left"
                       Foreground="Black" TextWrapping="Wrap" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Margin="0 24 0 95"
                       Text="{Binding UserAgreement}" TextAlignment="Left"
                       Foreground="#393939" TextWrapping="Wrap" FontSize="18" FontWeight="Normal">
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource TitleTextBoxStyle}" TargetType="TextBlock">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <Trigger Property="Opacity" Value="0">
                                <Setter Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard TargetProperty="Opacity">
                                        <DoubleAnimation To="1"
                                                         Duration="0:0:0.2"
                                                         BeginTime="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Template="{StaticResource MainButtonTemplate}"
                    Foreground="White" Background="#18AA7B"
                    Focusable="False"
                    FontWeight="SemiBold"
                    VerticalAlignment="Bottom"
                    FontSize="24"
                    Width="338" Height="94" BorderBrush="Transparent" Content="Закрыть"
                    Command="helpers:CommonCommands.ClosePopupCommand" />
        </StackPanel>
    </Border>
</UserControl>