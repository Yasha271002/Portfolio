<UserControl x:Class="SberUniversity.Views.Popups.ErrorPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SberUniversity.Views.Popups"
             xmlns:helpers="clr-namespace:SberUniversity.Helpers"
             xmlns:popups="clr-namespace:SberUniversity.ViewModel.Popups"
             mc:Ignorable="d">
    <UserControl.DataContext>
        <popups:ErrorPopupViewModel/>
    </UserControl.DataContext>
    <Border Width="788"
            Height="1148" CornerRadius="36">
        <Border.Background>
            <ImageBrush ImageSource="../../Resources/Images/SberBackground.png"/>
        </Border.Background>

        <StackPanel Margin="40 300">
            <TextBlock Style="{StaticResource TitleTextBoxStyle}"
                       Text="Что-то пошло не так"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Width="500"
                       TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource DefaultTextBoxStyle}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="36"
                       Margin="0 24 0 95"
                       Text="Проверьте введенные данные

                       и попробуйте еще раз"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Height="94">
                <Button Template="{StaticResource MainButtonTemplate}"
                        Content="На главную"
                        BorderBrush="White"
                        BorderThickness="2"
                        Focusable="False"
                        Foreground="White"
                        Width="338"
                        FontSize="24"
                        Command="{Binding OnStartPageCommand}">
                    <Button.Background>
                        <SolidColorBrush Color="White" Opacity="0.3"/>
                    </Button.Background>
                </Button>
                <Button Template="{StaticResource MainButtonTemplate}"
                        Content="Попробовать ещё раз"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Focusable="False"
                        FontWeight="SemiBold"
                        Background="White"
                        FontSize="24"
                        Margin="32 0 0 0"
                        Foreground="{StaticResource ButtonTextColor}"
                        Width="338"
                        Command="helpers:CommonCommands.ClosePopupCommand"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
