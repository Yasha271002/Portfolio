<Page x:Class="SberUniversity.Views.Page.QuizPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:controls="clr-namespace:SberUniversity.Views.Controls"
      xmlns:views="clr-namespace:SberUniversity.ViewModel.Views"
      xmlns:helpers="clr-namespace:SberUniversity.Helpers"
      mc:Ignorable="d" 
      Title="QuizPage"
      Style="{StaticResource PageBackground}"
      d:DataContext="{d:DesignInstance views:QuizPageViewModel, 
      IsDesignTimeCreatable=True}">
    <Grid Width="1080" Height="1920">
        <StackPanel Margin="60" >
            <Grid>
                <Button Width="223"
                        Height="62"
                        Template="{StaticResource MainButtonTemplate}"
                        Content="Назад"
                        HorizontalAlignment="Right"
                        Focusable="False"
                        FontSize="24"
                        Margin="14 0 0 0"
                        BorderBrush="White"
                        BorderThickness="1"
                        Foreground="White"
                        
                        Command="helpers:CommonCommands.GoBackCommand">
                    <Button.Background>
                        <SolidColorBrush Color="White" Opacity="0.3"/>
                    </Button.Background>
                </Button>
                <ContentPresenter ContentTemplate="{StaticResource LogoSberIcon}" 
                                  Width="368" 
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Left"/>
            </Grid>
            <TextBlock Style="{StaticResource TitleTextBoxStyle}"
                       Text="Оценка SberQ"
                       FontWeight="SemiBold"
                       TextAlignment="Left"
                       Margin="14 37 0 42 "/>
            <TextBlock Style="{StaticResource DefaultTextBoxStyle}"
                       TextAlignment="Left"
                       Text="Для прохождения оценки SberQ Top вам потребуется 8 часов, а для нашего сегодняшнего теста на карьерную осознанность — всего 1,5 минуты."
                       FontSize="24" TextWrapping="Wrap"
                       Margin="14 0 0 0"/>
            <TextBlock Style="{StaticResource DefaultTextBoxStyle}"
                       Text="Ответьте на 5 вопросов и получите рекомендации к развитию, а также узнайте больше про оценку SberQ и программы СберУниверситета. Результаты отправим на указанную вами электронную почту."
                       TextWrapping="Wrap"
                       TextAlignment="Left"
                       FontSize="24" 
                       Margin="14 20 0 42"/>
            <controls:QuizControl VerticalAlignment="Center"/>
            <Button Width="445"
                    Template="{StaticResource MainButtonTemplate}"
                    Content="Отправить ответы"
                    Background="White"
                    Height="109"
                    Focusable="False"
                    FontSize="36"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Command="{Binding NextPage}"
                    Foreground="{StaticResource ButtonTextColor}"
                    HorizontalAlignment="Left"
                    Margin="0 42 0 0"/>
        </StackPanel>
    </Grid>
</Page>
