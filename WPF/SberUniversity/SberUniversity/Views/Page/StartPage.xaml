<Page x:Class="SberUniversity.Views.Page.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SberUniversity.Views.Page"
      xmlns:controls="clr-namespace:SberUniversity.Views.Controls"
      xmlns:views="clr-namespace:SberUniversity.ViewModel.Views"
      xmlns:helpers="clr-namespace:SberUniversity.Helpers"
      mc:Ignorable="d"
      Title="StartPage"
      Style="{StaticResource PageBackground}">
    <Page.DataContext>
        <views:StartPageViewModel/>
    </Page.DataContext>
    <Grid Width="1080" Height="1920">
        <StackPanel Margin="60">
            <ContentPresenter ContentTemplate="{StaticResource LogoSberIcon}" Width="368" HorizontalAlignment="Left"
                              Margin="0 0 0 232"/>
            <ContentPresenter ContentTemplate="{StaticResource LogoIcon}" Width="672" Height="85"/>
            <TextBlock Text="SberQ — это сочетание инструментов психодиагностики и оценки компетенций с использованием реалистичной бизнес-симуляции для диагностики управленческих компетенций и потенциала. Метод разработан экспертами СберУниверситета, HR-блоком Сбера и Лабораторией нейронаук и поведения человека."
                       Style="{StaticResource DefaultTextBoxStyle}"
                       FontSize="36" TextWrapping="Wrap" HorizontalAlignment="Center"
                       TextAlignment="Center" Width="795"
                       Margin="0 63 0 0"/>
            <Image Source="../../Resources/Images/SberQrCode.png" Width="655"
                   Margin="0 95"/>
            <Button Width="510" Height="122"
                    Focusable="False"
                    Template="{StaticResource MainButtonTemplate}"
                    Foreground="{StaticResource ButtonTextColor}"
                    Content="Проверить себя"
                    FontWeight="SemiBold"
                    FontSize="36"
                    Background="White"
                    BorderBrush="Transparent"
                    Command="helpers:CommonCommands.NavigateCommand"
                    CommandParameter="{Binding Quizzes}"/>
        </StackPanel>
    </Grid>
</Page>